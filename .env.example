# ===== Feishu 自建應用（必填）=====
# open.feishu.cn → 開發者後台 → 企業自建應用 → 憑證與基礎資訊
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# 可選：只允許這些 chat_id 使用（逗號分隔，留空=全部放開）
FEISHU_ALLOW=

# ===== LLM（必填其一）=====
# deepseek | qwen | glm
LLM_PROVIDER=deepseek
# 可選：覆蓋預設模型名（deepseek-chat / qwen-plus / glm-4-plus）
LLM_MODEL=
DEEPSEEK_API_KEY=sk-xxxxxxxx
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=

# ===== 檢索（可選）=====
# auto（Google 新聞 RSS 為主，DuckDuckGo 備援，預設）| gnews | duckduckgo | tavily（需 key）
# | none（不做即時網路檢索，只查新聞監測庫；機器連不上 Google 時用）
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
# 可選：新聞監測（tw-news-monitor-simple）的新聞庫，檢索時優先查它
# 例：D:\WXWorkLocal\TW News-Monitor111\tw-news-monitor-simple\data\news.db（不要加引號以外的轉義）
NEWS_DB_PATH=

# ===== 存儲（可選，有預設值）=====
KB_DB_PATH=data/kb.sqlite3
CACHE_DIR=data/cache

# ===== Agent 調節（可選）=====
MAX_TOOL_ROUNDS=30
SESSION_HISTORY_TURNS=20
RACE_CYCLE=2026
