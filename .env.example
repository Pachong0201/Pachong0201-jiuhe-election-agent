# ===== Feishu 自建應用（必填）=====
# open.feishu.cn → 開發者後台 → 企業自建應用 → 憑證與基礎資訊
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# 可選：只允許這些 chat_id 使用（逗號分隔，留空=全部放開）
FEISHU_ALLOW=

# ===== LLM（必填其一）=====
# deepseek | qwen | glm
LLM_PROVIDER=deepseek
# 可選：覆蓋預設模型名（deepseek-chat / qwen-plus / glm-4-plus）
LLM_MODEL=
DEEPSEEK_API_KEY=sk-xxxxxxxx
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=

# ===== 檢索（可選）=====
# duckduckgo（免 key，預設）| tavily（需 key，質量更穩）
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# ===== 存儲（可選，有預設值）=====
KB_DB_PATH=data/kb.sqlite3
CACHE_DIR=data/cache

# ===== Agent 調節（可選）=====
MAX_TOOL_ROUNDS=12
SESSION_HISTORY_TURNS=20
RACE_CYCLE=2026
